# Steam "Recently played" on About page (optional)
# Get API key: https://steamcommunity.com/dev/apikey
# Steam ID: 64-bit ID (find at https://steamid.io when logged in, or from profile URL)
STEAM_API_KEY=
STEAM_ID=

# PlayStation "Recently played" on About page (optional)
# Log in at playstation.com, then open https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value.
# Expires about every 2 months; refresh it here and in Vercel when the widget shows "—".
PSN_NPSSO=
