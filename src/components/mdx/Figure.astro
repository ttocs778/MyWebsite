---
// An image with a visible caption, sized like a plain Markdown image
// (text width, max 24rem tall). Available in project MDX without an import:
//   <Figure caption="The first paper prototype">
//     ![Red construction paper board](./paper-prototype.jpg)
//   </Figure>
// For a wide image with a caption, use <Wide caption="..."> instead.
// `tall` lets a portrait screenshot (e.g. a node graph) go up to 40rem tall instead of 24rem.
interface Props {
	caption?: string;
	tall?: boolean;
}

const { caption, tall = false } = Astro.props;
---

<figure class:list={['figure', tall && 'is-tall']}>
	<slot />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 0.75rem 0 1.5rem;
	}

	.figure :global(p) {
		margin: 0;
	}

	.figure :global(img) {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 24rem;
		margin: 0 auto;
		border-radius: 10px;
	}

	.figure.is-tall :global(img) {
		max-height: 40rem;
	}
</style>
