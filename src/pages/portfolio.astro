---
import Layout from '../layouts/Layout.astro';

const gameAndGraphicsProjects = [
	{
		title: 'Lucky Duckies',
		date: 'Aug 2025 - Current',
		tech: ['Unreal Engine 5', 'C++',],
		description:
			'Lucky Duckies is a chaotic co-op 3D puzzle-platformer where two rubber duck parents rescue ducklings in an over-the-top, water-soaked bathroom. I built systems & UI as the core engineer.',
		image: '',
		href: '/portfolio/lucky-duckies',
	},
	{
		title: 'DirectX11 Custom Engine',
		date: 'Feb 2025 – May 2025',
		tech: ['DirectX11', 'C++', 'HLSL'],
		description:
			'This engine prototype built on DirectX11 API, featuring custom math/SIMD,  real-time rendering, lighting/material, animation, physics, multithreaded job, and post-processing effects.',
		image: '',
		href: '/portfolio/dx11-engine',
	},
	{
		title: 'Slash Bash',
		date: 'Jul 2024 - Feb 2025',
		tech: ['Unity', 'C#'],
		description:
			'Slash Bash is a 2D top-down 1v1 fighting game with nine characters, interactive arenas, and combo-driven fights. I led gameplay and design.',
		image: '',
		href: '/portfolio/slash-bash',
	},
	{
		title: 'SDL2 Game Projects',
		date: 'Aug 2024 - Dec 2024',
		tech: ['SDL2', 'C++'],
		description:
			'This is a series of classic games\' remakes, using the SDL library and C++. Here, I practiced making games from scratch using C++ and Actor-Component structure.',
		image: '',
		href: '/portfolio/sdl-projects',
	},
	{
		title: 'UE5 Multiplayer FPS',
		date: 'Sep 2025 - Dec 2025',
		tech: ['Unreal Engine 5', 'C++', 'Blueprints'],
		description:
			'A simple but meaningful class project made in UE5. I created a multiplayer FPS template with replication, UMG UI, GAS, and more.',
		image: '',
		href: '/portfolio/ue-fps',
	},
	{
		title: 'Small Games Collection',
		date: 'May 2023 - Aug 2024',
		tech: ['Unity', 'C#'],
		description:
			'Early game milestones/prototypes. Preserved here to keep my passions and to ensure I never forget the dream that set me on this path ',
		image: '',
		href: '/portfolio/game-collection',
	},
];

const fullStackProjects = [
	{
		title: 'Full-Stack Project One',
		date: '2026',
		tech: ['React', 'Node.js', 'PostgreSQL'],
		description:
			'A production-style web app with auth, CRUD workflows, and a clean component-driven UI.',
		image: '',
		href: '/portfolio/full-stack-project-one',
	},
	{
		title: 'Full-Stack Project Two',
		date: '2026',
		tech: ['Next.js', 'TypeScript', 'REST API'],
		description:
			'A full-stack platform focused on scalable API design, data flows, and polished frontend UX.',
		image: '',
		href: '/portfolio/full-stack-project-two',
	},
];

const analogBoardGameProjects = [
	{
		title: 'Board Game Prototype One',
		date: '2025',
		tech: ['Game Design', 'Paper Prototyping', 'Playtesting'],
		description:
			'A competitive tabletop prototype focused on fast turns, clear rules, and replayable strategy.',
		image: '',
		href: '/portfolio/board-game-prototype-one',
	},
	{
		title: 'Board Game Prototype Two',
		date: '2025',
		tech: ['Systems Design', 'Balancing', 'Iteration'],
		description:
			'A systems-driven board game concept iterated through multiple rounds of balance tuning.',
		image: '',
		href: '/portfolio/board-game-prototype-two',
	},
	{
		title: 'Analog Puzzle Design',
		date: '2024',
		tech: ['Level Design', 'UX', 'Puzzle Logic'],
		description:
			'An analog puzzle experience built around readable mechanics and cooperative problem solving.',
		image: '',
		href: '/portfolio/analog-puzzle-design',
	},
];
---

<Layout title="Rui (Scott) Tang – Portfolio">
	<section class="page">
		<div class="page-title-row">
			<div class="page-title-left">
				<h1>Portfolio</h1>
			</div>
			<p class="page-title-caption">
				From Board to Bytes.
			</p>
		</div>

		<div class="portfolio-sections">
			<section class="portfolio-section">
				<h1 class="portfolio-section-title">Game & Graphics Projects</h1>
				<div class="portfolio-grid">
					{gameAndGraphicsProjects.map((project) => (
						<a href={project.href} class="portfolio-card">
							<div class="card-image-wrap">
								{project.image ? (
									<img src={project.image} alt="" class="card-image" />
								) : (
									<div class="card-image-placeholder" aria-hidden="true" />
								)}
							</div>
							<div class="card-body">
								<h2 class="card-title">{project.title}</h2>
								<p class="card-date">{project.date}</p>
								<ul class="card-tech-list" aria-label="Technologies">
									{project.tech.map((t) => (
										<li>{t}</li>
									))}
								</ul>
								<p class="card-description">{project.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="portfolio-section">
				<h1 class="portfolio-section-title">Full-Stack Web Projects</h1>
				<div class="portfolio-grid">
					{fullStackProjects.map((project) => (
						<a href={project.href} class="portfolio-card">
							<div class="card-image-wrap">
								{project.image ? (
									<img src={project.image} alt="" class="card-image" />
								) : (
									<div class="card-image-placeholder" aria-hidden="true" />
								)}
							</div>
							<div class="card-body">
								<h2 class="card-title">{project.title}</h2>
								<p class="card-date">{project.date}</p>
								<ul class="card-tech-list" aria-label="Technologies">
									{project.tech.map((t) => (
										<li>{t}</li>
									))}
								</ul>
								<p class="card-description">{project.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="portfolio-section">
				<h1 class="portfolio-section-title">Analog & Board Game Design</h1>
				<div class="portfolio-grid">
					{analogBoardGameProjects.map((project) => (
						<a href={project.href} class="portfolio-card">
							<div class="card-image-wrap">
								{project.image ? (
									<img src={project.image} alt="" class="card-image" />
								) : (
									<div class="card-image-placeholder" aria-hidden="true" />
								)}
							</div>
							<div class="card-body">
								<h2 class="card-title">{project.title}</h2>
								<p class="card-date">{project.date}</p>
								<ul class="card-tech-list" aria-label="Technologies">
									{project.tech.map((t) => (
										<li>{t}</li>
									))}
								</ul>
								<p class="card-description">{project.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		</div>
	</section>

	<style>
		.page {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		h1 {
			margin: 0 0 0.25rem;
			font-size: 1.6rem;
			letter-spacing: 0.001em;
		}

		.page-title-row h1 {
			margin: 0;
			font-size: 3.4rem;
			line-height: 1.2;
			text-transform: none;
		}

		p {
			margin: 0;
			font-size: 1.05rem;
			line-height: 1.7;
		}

		.portfolio-sections {
			display: flex;
			flex-direction: column;
			gap: 3.5rem;
		}

		.portfolio-section {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 3rem;
		}

		.portfolio-section-title {
			margin: 0;
			width: min(70rem, calc(0.65 * (100vw - 3.5rem)));
			max-width: 70rem;
			font-size: 1.65rem;
			line-height: 1.2;
			font-weight: 700;
			letter-spacing: 0.015em;
			color: #dbe7ff;
			text-align: center;
			text-shadow: 0 1px 10px rgba(0, 111, 205, 0.18);
			padding-bottom: 0.55rem;
			position: relative;
		}

		.portfolio-section-title::after {
			content: '';
			display: block;
			width: 3.5rem;
			height: 2px;
			margin: 0.55rem auto 0;
			border-radius: 999px;
			background: linear-gradient(90deg, rgba(0, 111, 205, 0.12), rgba(0, 111, 205, 0.75), rgba(0, 111, 205, 0.12));
		}

		.portfolio-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 3.5rem;
			/* Same width as title row and footer bar */
			width: min(70rem, calc(0.65 * (100vw - 3.5rem)));
			max-width: 70rem;
		}

		.portfolio-card {
			display: flex;
			flex-direction: column;
			overflow: hidden;
			text-decoration: none;
			color: inherit;
			border-radius: 12px;
			transition: opacity 0.2s, transform 0.2s;
		}

		.portfolio-card:hover {
			opacity: 0.92;
		}

		.card-image-wrap {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 12px;
			overflow: hidden;
			background: rgba(255, 255, 255, 0.04);
			margin-bottom: 0.75rem;
		}

		.card-image,
		.card-image-placeholder {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.card-image-placeholder {
			display: block;
			background: rgba(161, 161, 170, 0.12);
		}

		.card-body {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}

		.card-title {
			margin: 0;
			font-size: 1.25rem;
			font-weight: 700;
			letter-spacing: 0.02em;
			color: #fafafa;
		}

		.card-date {
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.6);
		}

		.card-tech-list {
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-wrap: wrap;
			gap: 0 0.75rem;
			font-size: 0.95rem;
			color: #a5b4fc;
			letter-spacing: 0.02em;
		}

		.card-tech-list li + li::before {
			content: '·';
			margin-right: 0.75rem;
			color: rgba(165, 180, 252, 0.6);
		}

		.card-description {
			margin: 0.3rem 0 0;
			font-size: 1.05rem;
			line-height: 1.65;
			color: rgba(255, 255, 255, 0.8);
		}

		@media (max-width: 900px) {
			.portfolio-grid {
				grid-template-columns: 1fr;
				gap: 3rem;
			}
		}
	</style>
</Layout>
