---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Card content (title, date, tech, description, image) comes from each project's
// src/content/projects/<slug>/index.mdx frontmatter. This file only decides which
// section a project sits in and in what order.
const sectionOrder = [
	{
		title: 'Game & Graphics Projects',
		slugs: ['lucky-duckies', 'dx11-engine', 'slash-bash', 'sdl-projects', 'ue-fps', 'game-collection'],
	},
	{
		title: 'Full-Stack Web Projects',
		slugs: ['fitness-goal-tracker', 'my-website'],
	},
	{
		title: 'Analog & Board Game Design',
		slugs: ['date-dash', 'love-panic', 'spell-showdown'],
	},
];

const projects = new Map((await getCollection('projects')).map((entry) => [entry.slug, entry]));
const sections = sectionOrder.map(({ title, slugs }) => ({
	title,
	projects: slugs.map((slug) => {
		const entry = projects.get(slug);
		if (!entry) throw new Error(`portfolio.astro: no project "${slug}" in src/content/projects`);
		return { ...entry.data, href: `/portfolio/${slug}` };
	}),
}));
const listed = new Set(sectionOrder.flatMap((section) => section.slugs));
const unlisted = [...projects.keys()].filter((slug) => !listed.has(slug));
if (unlisted.length) console.warn(`portfolio.astro: projects not placed in any section: ${unlisted.join(', ')}`);
---

<Layout title="Scott Tang – Portfolio">
	<section class="page">
		<div class="page-title-row">
			<div class="page-title-left">
				<h1>Portfolio</h1>
			</div>
			<p class="page-title-caption">
				From Board to Bytes.
			</p>
		</div>

		<div class="portfolio-sections">
			{sections.map((section) => (
				<section class="portfolio-section">
					<h1 class="portfolio-section-title">{section.title}</h1>
					<div class="portfolio-grid">
						{section.projects.map((project) => (
							<a href={project.href} class="portfolio-card">
								<div class="card-image-wrap">
									{project.image ? (
										<Image src={project.image} alt={project.title} class="card-image" width={640} height={360} />
									) : (
										<div class="card-image-placeholder" aria-hidden="true" />
									)}
								</div>
								<div class="card-body">
									<h2 class="card-title">{project.title}</h2>
									<p class="card-date">{project.date}</p>
									<ul class="card-tech-list" aria-label="Technologies">
										{project.tech.map((t) => (
											<li>{t}</li>
										))}
									</ul>
									<p class="card-description">{project.description}</p>
								</div>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</section>

	<style>
		.page {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		h1 {
			margin: 0 0 0.25rem;
			font-size: 1.6rem;
			letter-spacing: 0.001em;
		}

		.page-title-row h1 {
			margin: 0;
			font-size: 3.4rem;
			line-height: 1.2;
			text-transform: none;
		}

		p {
			margin: 0;
			font-size: 1.05rem;
			line-height: 1.7;
		}

		.portfolio-sections {
			display: flex;
			flex-direction: column;
			gap: 3.5rem;
		}

		.portfolio-section {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 3rem;
		}

		.portfolio-section-title {
			margin: 0;
			width: min(70rem, var(--fluid-width));
			max-width: 70rem;
			font-size: 1.65rem;
			line-height: 1.2;
			font-weight: 700;
			letter-spacing: 0.015em;
			color: #dbe7ff;
			text-align: center;
			text-shadow: 0 1px 10px color-mix(in srgb, var(--accent) 18%, transparent);
			padding-bottom: 0.55rem;
			position: relative;
		}

		.portfolio-section-title::after {
			content: '';
			display: block;
			width: 3.5rem;
			height: 2px;
			margin: 0.55rem auto 0;
			border-radius: 999px;
			background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 12%, transparent), color-mix(in srgb, var(--accent) 75%, transparent), color-mix(in srgb, var(--accent) 12%, transparent));
		}

		.portfolio-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 3.5rem;
			/* Same width as title row and footer bar */
			width: min(70rem, var(--fluid-width));
			max-width: 70rem;
		}

		.portfolio-card {
			position: relative;
			isolation: isolate;
			display: flex;
			flex-direction: column;
			text-decoration: none;
			color: inherit;
			border-radius: 12px;
		}

		/* Reddit-style hover: a soft panel fades in behind the whole card, reaching a
		   little past its edges (stays inside the grid gap) */
		.portfolio-card::before {
			content: '';
			position: absolute;
			inset: -1rem;
			z-index: -1;
			border-radius: 18px;
			background: rgba(148, 163, 184, 0.04);
			border: 1px solid rgba(148, 163, 184, 0.07);
			opacity: 0;
			transform: scale(0.98);
			transition: opacity 0.2s ease, transform 0.2s ease;
			pointer-events: none;
		}

		.portfolio-card:hover::before,
		.portfolio-card:focus-visible::before {
			opacity: 1;
			transform: scale(1);
		}

		.portfolio-card:focus-visible {
			outline: none;
		}

		.portfolio-card:hover .card-title,
		.portfolio-card:focus-visible .card-title {
			color: var(--accent-hover);
		}

		@media (prefers-reduced-motion: reduce) {
			.portfolio-card::before {
				transition: none;
				transform: none;
			}
		}

		.card-image-wrap {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 12px;
			overflow: hidden;
			background: rgba(255, 255, 255, 0.04);
			margin-bottom: 0.75rem;
		}

		.card-image,
		.card-image-placeholder {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.card-image-placeholder {
			display: block;
			background: rgba(161, 161, 170, 0.12);
		}

		.card-body {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}

		.card-title {
			margin: 0;
			font-size: 1.25rem;
			font-weight: 700;
			letter-spacing: 0.02em;
			color: #fafafa;
		}

		.card-date {
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.6);
		}

		.card-tech-list {
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-wrap: wrap;
			gap: 0 0.75rem;
			font-size: 0.95rem;
			color: var(--accent);
			letter-spacing: 0.02em;
		}

		.card-tech-list li + li::before {
			content: '·';
			margin-right: 0.75rem;
			color: color-mix(in srgb, var(--accent) 60%, transparent);
		}

		.card-description {
			margin: 0.3rem 0 0;
			font-size: 1.05rem;
			line-height: 1.65;
			color: rgba(255, 255, 255, 0.8);
		}

		@media (max-width: 900px) {
			.portfolio-grid {
				grid-template-columns: 1fr;
				gap: 3rem;
			}
		}
	</style>
</Layout>
