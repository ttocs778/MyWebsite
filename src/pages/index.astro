---
import Layout from '../layouts/Layout.astro';
import PixelVideoBackground from '../components/PixelVideoBackground.astro';
---

<Layout title="Scott Tang – Home" showVideoBackground={true} showFooter={false}>
	<PixelVideoBackground
		slot="background"
		src="/videos/home-loop.mp4"
		cuts={[0, 8, 15.9, 20, 23.8, 28.1, 34.1, 37.6, 41.6, 45.7, 53.2]}
	/>
	<section class="hero">
		<div class="hero-main">
			<p class="eyebrow">Game & Graphics Engineer</p>
			<h1 class="hero-title"><span class="hero-title-inner">Hi! I&apos;m Scott Tang!</span></h1>
			<p class="lede">I build games, engines, and graphics.</p>
			<nav class="hero-nav" aria-label="Main navigation">
				<a href="/portfolio" class="hero-nav-link">
					<svg class="hero-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 13-8.381 8.38a1 1 0 0 1-3.001-3L11 9.999"/><path d="M15.973 4.027A13 13 0 0 0 5.902 2.373c-1.398.342-1.092 2.158.277 2.601a19.9 19.9 0 0 1 5.822 3.024"/><path d="M16.001 11.999a19.9 19.9 0 0 1 3.024 5.824c.444 1.369 2.26 1.676 2.603.278A13 13 0 0 0 20 8.069"/><path d="M18.352 3.352a1.205 1.205 0 0 0-1.704 0l-5.296 5.296a1.205 1.205 0 0 0 0 1.704l2.296 2.296a1.205 1.205 0 0 0 1.704 0l5.296-5.296a1.205 1.205 0 0 0 0-1.704z"/></svg>
					<span>Portfolio</span>
				</a>
				<a href="/notes" class="hero-nav-link">
					<svg class="hero-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/></svg>
					<span>Notes</span>
				</a>
				<a href="/about" class="hero-nav-link">
					<svg class="hero-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M15 12h.01"/><path d="M19.38 6.813A9 9 0 0 1 20.8 10.2a2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/><path d="M9 12h.01"/></svg>
					<span>About</span>
				</a>
			</nav>
			<div class="contact-links" aria-label="Contact links">
				<a href="https://www.instagram.com/ruiscott_39/" class="contact-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
				</a>
				<a href="https://github.com/ttocs778" class="contact-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				</a>
				<a href="https://www.linkedin.com/in/ttocs778/" class="contact-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
				</a>
			</div>
		</div>
	</section>

	<style>
		.hero {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 1.75rem;
			max-width: 40em;
			/* everything in the hero is sized in em, so it scales with the window: 16px up to ~1300px wide; title is 50px at 1920 and 60px at 2560 */
			font-size: clamp(1rem, 0.446rem + 0.558vw, 1.34rem);
			position: relative;
			isolation: isolate;
			text-shadow: 0 2px 10px rgba(12, 15, 26, 0.85);
		}

		/* soft dark pool behind the text, so a bright clip in the background never washes it out */
		.hero::before {
			content: '';
			position: absolute;
			inset: -3em -5em;
			z-index: -1;
			background: radial-gradient(ellipse closest-side, rgba(12, 15, 26, 0.6), rgba(12, 15, 26, 0.35) 55%, transparent);
			pointer-events: none;
		}

		.hero-main {
			display: grid;
			grid-template-areas:
				'eyebrow'
				'title'
				'lede'
				'nav'
				'contacts';
			/* two levels: eyebrow / title / intro sit tight as one block (negative margins below),
			   then the same larger gap before the nav and before the icons */
			row-gap: var(--hero-gap, 1.4em);
			width: 100%;
		}

		.eyebrow {
			grid-area: eyebrow;
			justify-self: center;
			text-align: center;
			margin: 0;
			padding: 0;
			font-size: 0.8em;
			text-transform: uppercase;
			letter-spacing: 0.18em;
			color: var(--accent-light);
			margin-bottom: -1.45em !important;
			opacity: 0;
			transform: translateY(0.7rem);
			animation: hero-fade-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
		}

		h1.hero-title {
			grid-area: title;
			margin: 0;
			padding: 0;
			font-size: clamp(2.2em, 4vw, 2.8em);
			line-height: 1.15;
			letter-spacing: 0.03em;
			color: #f1f5f9;
		}

		.hero-title-inner {
			display: inline-block;
			opacity: 0;
			transform: translateY(1.25rem);
			/* Fade in + subtle glow; letters handle their own looping motion */
			animation:
				hero-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards,
				hero-title-glow 3.4s ease-in-out 0.9s infinite;
		}

		h1::first-letter {
			margin-left: 0;
		}

		.hero-nav {
			grid-area: nav;
			justify-self: center;
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			opacity: 0;
			transform: translateY(1rem);
			animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
		}

		/* same voice as the eyebrow: small, uppercase, spaced out; dots between links */
		.hero-nav-link {
			position: relative;
			display: inline-flex;
			align-items: center;
			gap: 0.5em;
			padding: 0.3em 1.1em;
			color: #cbd5e1;
			font-size: 0.85em;
			font-weight: 600;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.hero-nav-link + .hero-nav-link::before {
			content: '·';
			position: absolute;
			left: -0.15em;
			color: var(--accent-light);
			letter-spacing: 0;
		}

		/* underline that grows from the centre on hover (the right inset skips the trailing letter-spacing) */
		.hero-nav-link::after {
			content: '';
			position: absolute;
			left: calc(1.1em + 1.5em);
			right: calc(1.1em + 0.18em);
			bottom: 0.2em;
			height: 1px;
			background: var(--accent-light);
			transform: scaleX(0);
			transition: transform 0.2s ease;
		}

		.hero-nav-icon {
			color: var(--accent-light);
			width: 1.2em;
			height: 1.2em;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.hero-nav-link:hover {
			color: #fff;
		}

		.hero-nav-link:hover::after {
			transform: scaleX(1);
		}

		.contact-links {
			grid-area: contacts;
			margin-top: -0.2em !important; /* the 2.5em hover boxes pad a little space above the icons */
			justify-self: center;
			display: flex;
			align-items: center;
			gap: 0.75rem;
			margin: 0;
			padding: 0;
			opacity: 0;
			transform: translateY(1rem);
			animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
		}

		.contact-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.5em;
			height: 2.5em;
			border-radius: 10px;
			color: #e2e8f0;
			background: transparent;
			transition: color 0.2s ease, transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
		}

		.contact-link:hover {
			color: #fff;
			background: rgba(255, 255, 255, 0.08);
			box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
			transform: translateY(-2px);
		}

		.contact-link svg {
			width: 1.4em;
			height: 1.4em;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.lede {
			grid-area: lede;
			margin-top: -0.9em !important; /* tight under the title */
			margin: 0;
			justify-self: center;
			text-align: center; /* centred under the title like everything else, not left-aligned */
			padding: 0;
			color: #e2e8f0;
			font-size: 1em;
			line-height: 1.4;
			max-width: 44rem;
			opacity: 0;
			transform: translateY(0.9rem);
			animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
		}

		@keyframes hero-fade-up {
			from {
				opacity: 0;
				transform: translateY(1.25rem);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@keyframes hero-title-glow {
			0%,
			100% {
				text-shadow:
					0 0 0 rgba(129, 140, 248, 0),
					0 0 0 rgba(244, 244, 245, 0);
			}
			50% {
				text-shadow:
					0 0 8px rgba(129, 140, 248, 0.85),
					0 0 16px rgba(244, 244, 245, 0.9);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.eyebrow,
			.hero-title-inner,
			.hero-letter,
			.lede,
			.hero-nav,
			.contact-links {
				animation: none !important;
				opacity: 1;
				transform: none;
				text-shadow: none;
			}
		}

		@media (max-width: 640px) {
			.hero {
				max-width: 100%;
			}
		}
	</style>
</Layout>
