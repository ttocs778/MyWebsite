---
import { getCollection } from 'astro:content';
import NotesShell from '../../components/notes/NotesShell.astro';
import nav from '../../data/notes-nav.json';

const notes = await getCollection('notes');
const recent = [...notes]
	.sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
	.slice(0, 6);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<NotesShell title="Scott Tang – Notes">
	<div class="notes-overview">
		<div class="overview-intro">
			{nav.intro.map((html) => <p set:html={html} />)}
		</div>

		<dl class="overview-stats">
			<div><dt>Cards</dt><dd>{notes.length}</dd></div>
			<div><dt>Topics</dt><dd>{nav.sections.reduce((n, s) => n + s.groups.length, 0)}</dd></div>
			<div><dt>Last updated</dt><dd>{fmt(recent[0].data.updated)}</dd></div>
		</dl>

		<section class="overview-recent">
			<h2>Recently updated</h2>
			<ul>
				{recent.map((n) => (
					<li>
						<a href={`/notes/${n.id}`}>
							<span class="recent-title">{n.data.title}</span>
							<span class="recent-date">{fmt(n.data.updated)}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<p class="overview-hint">Pick a card from the list to start reading.</p>
	</div>
</NotesShell>

<style>
	.notes-overview {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.overview-intro {
		color: #cbd5e1;
		font-size: 1.1rem;
		line-height: 1.75;
	}

	.overview-intro p {
		margin: 0;
	}

	.overview-intro p + p {
		margin-top: 1rem;
	}

	.overview-intro :global(code) {
		padding: 0.1em 0.4em;
		border-radius: 5px;
		background: rgba(148, 163, 184, 0.14);
		color: #e2e8f0;
		font-size: 0.9em;
	}

	.overview-stats {
		display: flex;
		gap: 2.5rem;
		margin: 0;
	}

	.overview-stats dt {
		color: #64748b;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.overview-stats dd {
		margin: 0.2rem 0 0;
		color: #f1f5f9;
		font-size: 1.6rem;
		font-weight: 700;
	}

	.overview-recent h2 {
		margin: 0 0 0.75rem;
		color: #94a3b8;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.overview-recent ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(148, 163, 184, 0.15);
	}

	.overview-recent a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0.25rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.15);
		color: #cbd5e1;
		text-decoration: none;
		transition: color 0.15s, padding-left 0.15s;
	}

	.overview-recent a:hover {
		color: #f1f5f9;
		padding-left: 0.6rem;
	}

	.recent-date {
		flex-shrink: 0;
		color: #64748b;
		font-size: 0.85rem;
	}

	.overview-hint {
		margin: 0;
		color: #64748b;
		font-size: 0.95rem;
	}

	@media (max-width: 640px) {
		.overview-hint {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.overview-recent a {
			transition: none;
		}
	}
</style>
